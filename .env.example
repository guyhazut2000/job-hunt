# --- Database (docker compose up -d db) ---
DATABASE_URL="postgresql://jobhunt:jobhunt@localhost:5432/jobhunt?schema=public"

# --- Auth.js --- generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# AUTH_URL="https://your-domain.com"   # required in some production setups

# --- AI provider --- leave empty to use the offline mock provider
LLM_PROVIDER=""            # "openai" | "mock"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL=""            # any OpenAI-compatible endpoint; defaults to api.openai.com

# --- Billing (Stripe) --- billing stays disabled until both are set
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO=""
STRIPE_WEBHOOK_SECRET=""

# --- Ingestion cron --- POST /api/cron/ingest with "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""

# --- Analytics --- "console" | "none" (add PostHog/GA4 sinks in src/lib/analytics.ts)
NEXT_PUBLIC_ANALYTICS_PROVIDER="console"

# --- Seed ---
SEED_ADMIN_EMAIL="admin@job-hunt.local"
SEED_PASSWORD="password123"
