# --- Database (docker compose up -d db) ---
DATABASE_URL="postgresql://jobhunt:jobhunt@localhost:5432/jobhunt?schema=public"

# --- Auth.js --- generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# AUTH_URL="https://your-domain.com"   # required in some production setups

# --- AI provider --- see docs/ai.md. Without a key the app uses the offline mock (heuristics only).
GEMINI_API_KEY=""          # Google AI Studio key (free tier)
GEMINI_MODEL="gemini-3.5-flash-lite"
LLM_PROVIDER=""            # "gemini" | "openai" | "mock" (mock = kill switch). Empty = auto-detect from keys
LLM_API_KEY=""             # only for LLM_PROVIDER=openai
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL=""            # any OpenAI-compatible endpoint; defaults to api.openai.com
# Optional free-tier guards (defaults shown)
# AI_USER_DAILY_LIMIT="15"     # uncached AI calls per user / rolling 24h
# AI_GLOBAL_DAILY_CAP="400"    # uncached AI calls for the app / rolling 24h (free tier ~500 RPD)
# AI_GLOBAL_PER_MINUTE="8"     # uncached AI calls for the app / minute (free tier ~10-15 RPM)
# AI_CACHE_TTL_HOURS="720"     # identical prompts are served from the DB for 30 days

# --- Billing (Stripe) --- billing stays disabled until both are set
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO=""
STRIPE_WEBHOOK_SECRET=""

# --- Ingestion cron --- POST /api/cron/ingest with "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""

# --- Analytics --- "console" | "none" (add PostHog/GA4 sinks in src/lib/analytics.ts)
NEXT_PUBLIC_ANALYTICS_PROVIDER="console"

# --- Seed ---
SEED_ADMIN_EMAIL="admin@job-hunt.local"
SEED_PASSWORD="password123"

# --- People search (Brave Search API) --- see docs/people-search.md
# Without a key the "people at the company" section keeps the deep-link buttons only.
BRAVE_SEARCH_API_KEY=""
# Optional tuning (defaults shown)
# PEOPLE_SEARCH_CACHE_TTL_HOURS="168"   # see the Brave ToS caveat in the docs
# PEOPLE_SEARCH_PER_MINUTE="20"         # per user, cached + uncached
# PEOPLE_SEARCH_DAILY_CAP="40"          # per user, uncached Brave calls / rolling 24h
# BRAVE_MONTHLY_CAP="900"               # global, uncached Brave calls / rolling 30 days (people + LinkedIn job links)
# LINKEDIN_JOB_MONTHLY_CAP="300"        # slice of the Brave cap for exact LinkedIn posting lookups
# LINKEDIN_JOB_INGEST_BATCH="10"        # lookups per daily ingest run (newest unchecked jobs)
# BRAVE_MIN_INTERVAL_MS="1100"          # pacing between Brave requests
# PEOPLE_SEARCH_MOCK="1"                # local only: synthetic results, ignored when VERCEL_ENV=production
