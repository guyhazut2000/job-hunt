{
  "name": "job-hunt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && node scripts/migrate-on-build.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "ingest": "tsx scripts/ingest.ts",
    "sources:verify": "tsx scripts/verify-sources.ts",
    "db:check-additive": "node scripts/check-migrations-additive.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.139",
    "@ai-sdk/react": "^3.0.320",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.2",
    "ai": "^6.0.317",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.62.0",
    "mammoth": "^1.13.0",
    "next": "15.5.28",
    "next-auth": "^5.0.0-beta.29",
    "radix-ui": "^1.8.1",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
