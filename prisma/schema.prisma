generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

/// DEPRECATED: pricing was removed (non-commercial practice project). Kept only because migrations
/// are additive-only; nothing reads or writes it.
enum Plan {
  FREE
  PRO
}

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
}

/// Job-board style experience level, derived from the title. Finer than `Seniority`
/// (which the profile matcher uses): it separates directors and executives from line managers.
enum JobLevel {
  INTERN
  ENTRY
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum SkillLevel {
  BASIC
  GOOD
  EXPERT
}

enum Availability {
  ACTIVE
  OPEN
  NOT_LOOKING
}

enum AtsProvider {
  GREENHOUSE
  LEVER
  COMEET
  MANUAL
  ASHBY
  WORKABLE
  SMARTRECRUITERS
  WORKDAY
  RECRUITEE
  WORDPRESS
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
}

model User {
  id                   String                  @id @default(cuid())
  email                String                  @unique
  name                 String?
  passwordHash         String
  role                 Role                    @default(USER)
  /// DEPRECATED: unused since pricing was removed; kept for additive-only migrations.
  plan                 Plan                    @default(FREE)
  locale               String                  @default("he")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  profile              Profile?
  resumes              Resume[]
  applications         Application[]
  /// DEPRECATED: unused since pricing was removed.
  subscription         Subscription?
  contacts             Contact[]
  emailSync            EmailSyncSettings?
  emailAccounts        EmailAccount[]
  emailCandidates      EmailCandidate[]
  skillProgress        SkillProgress[]
  savedPlaces          SavedPlace[]
  documents            Document[]
  stageProgress        StageProgress[]
  studySessions        StudySession[]
  questionReviews      QuestionReview[]
  tutorThreads         TutorThread[]
  chatThreads          ChatThread[]
  learningPrefs        LearningPrefs?
  hiringProcesses      HiringProcess[]
  answerFeedback       AnswerFeedback[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference?
  savedSearches        SavedSearch[]
  digests              Digest[]
  notificationChannels NotificationChannel[]
}

model Profile {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String?
  desiredRole     String?
  seniority       Seniority?
  location        String?
  workMode        WorkMode?
  yearsExperience Int?
  skills          String[]
  linkedinUrl     String?
  updatedAt       DateTime   @updatedAt

  // ── v2 professional profile (validated by zod in src/lib/profile/schema.ts) ──
  summary           String?
  githubUrl         String?
  portfolioUrl      String?
  experience        Json          @default("[]")
  skillItems        Json          @default("[]")
  education         Json          @default("[]")
  languages         Json          @default("[]")
  // ── v2 preferences ──
  targetRoles       String[]      @default([])
  targetSeniorities Seniority[]   @default([])
  regions           String[]      @default([])
  workModes         WorkMode[]    @default([])
  salaryMin         Int?
  salaryMax         Int?
  companyTypes      String[]      @default([])
  wantedTech        String[]      @default([])
  avoidTech         String[]      @default([])
  availability      Availability?
  onboardedAt       DateTime?
}

model Resume {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  text      String
  skills    String[]
  isPrimary Boolean     @default(true)
  createdAt DateTime    @default(now())
  label     String?
  extracted Json?
  appliedAt DateTime?
  file      ResumeFile?

  @@index([userId])
}

/// Original uploaded CV bytes. Kept in a separate table so listing resumes never loads blobs.
/// No Vercel Blob store is configured for this project, so files live in Postgres (bytea, max 5MB).
model ResumeFile {
  id        String   @id @default(cuid())
  resumeId  String   @unique
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  data      Bytes
  createdAt DateTime @default(now())
}

model Company {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  website      String?
  description  String?
  industry     String?
  size         String?
  hqLocation   String?
  logoUrl      String?
  /// Normalized https://www.linkedin.com/company/<slug>/ set by an admin; never fetched (see docs/linkedin-links.md).
  linkedinUrl  String?
  atsProvider  AtsProvider    @default(MANUAL)
  atsBoardId   String?
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  jobs         Job[]
  contacts     Contact[]
  salaries     SalaryReport[]

  /// AUTO = jobs are pulled from `atsProvider`/`atsBoardId`; MANUAL = no working feed, the user checks
  /// `careersUrl` by hand. Companies are never hidden or deleted because a feed is missing or failing.
  syncMode          CompanySyncMode    @default(AUTO)
  /// The company's own careers page (never a LinkedIn URL).
  careersUrl        String?
  notesHe           String?
  notesEn           String?
  /// Last ingest error for an AUTO company (cleared on the next successful sync).
  lastSyncError     String?
  lastSyncErrorAt   DateTime?
  /// Consecutive failed syncs; >= SYNC_FAILING_THRESHOLD shows a "feed failing" note in the UI.
  syncFailures      Int                @default(0)
  /// How the company got here: "curated", "manual-seed", "admin", "discovery:YC", "discovery:WIKIDATA"…
  addedVia          String?
  startupCandidates StartupCandidate[]
  hiringProcesses   HiringProcess[]

  /// Optional office override for the jobs map (docs/jobs-map.md), set by an admin. When `officeCity`
  /// is set it replaces only that city's pin; null applies to all of the company's jobs.
  officeAddress String?
  officeLat     Float?
  officeLng     Float?
  officeCity    String?

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_name_trgm_idx")
}

enum CompanySyncMode {
  AUTO
  MANUAL
}

enum StartupCandidateStatus {
  /// Waiting for an admin (no supported ATS with Israeli openings was detected).
  PENDING
  /// Became a Company (AUTO if an ATS feed was detected, otherwise MANUAL).
  ADDED
  REJECTED
  /// Already in the app under another name/source.
  DUPLICATE
}

/// Startup discovery (docs/startup-discovery.md): companies found in public directories, waiting to be
/// checked for a careers page / ATS and added. One row per website domain.
model StartupCandidate {
  id               String                 @id @default(cuid())
  domain           String                 @unique
  name             String
  website          String
  source           String
  sourceUrl        String?
  description      String?
  location         String?
  industry         String?
  /// TechMap size bucket (xs 1-10, s 11-50, m 51-200, l 201-1,000, xl 1,001+) when known.
  size             String?
  foundedYear      Int?
  /// Higher = checked first (bigger companies, known ATS hints, hiring signals).
  priority         Int                    @default(0)
  /// ATS identifiers the source already knows (e.g. TechMap greenhouseId / leverId / comeetId).
  hints            Json?
  status           StartupCandidateStatus @default(PENDING)
  /// Result of the last ATS check of the company's own site.
  careersUrl       String?
  detectedProvider AtsProvider?
  detectedBoardId  String?
  israelJobs       Int?
  checkedAt        DateTime?
  checkError       String?
  companyId        String?
  company          Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([status, checkedAt])
  @@index([checkedAt, priority])
}

/// One discovery cron/admin run: import from the public directories and/or check a batch of candidates.
model DiscoveryRun {
  id         String    @id @default(cuid())
  trigger    String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// New candidates per source, e.g. {"TECHMAP": 812, "YC": 20}.
  imported   Json?
  checked    Int       @default(0)
  addedAuto  Int       @default(0)
  pending    Int       @default(0)
  error      String?
}

/// Anonymous salary report. No user id, no free text: `reporterKey` is an HMAC of the user id
/// (keyed with AUTH_SECRET) used only for de-duplication and rate limiting. Only aggregates over
/// >= 5 reports are ever shown (see src/lib/salary).
model SalaryReport {
  id              String    @id @default(cuid())
  reporterKey     String
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  family          String
  seniority       Seniority
  yearsExperience Int?
  monthlyGrossIls Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([reporterKey, companyId, family])
  @@index([companyId, family, seniority])
  @@index([family, seniority])
  @@index([reporterKey, updatedAt])
}

model Job {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId        String
  source            AtsProvider
  title             String
  roleCategory      String
  seniority         Seniority
  location          String
  workMode          WorkMode
  techStack         String[]
  description       String
  applyUrl          String
  postedAt          DateTime
  /// Broad job function (engineering, data, sales, marketing…) — see src/lib/jobs/classify.ts.
  jobFunction       String          @default("other")
  /// Professional domain (תחום) from the deterministic classifier in src/lib/jobs/domain-classifier.ts.
  domain            String          @default("other")
  level             JobLevel        @default(MID)
  employmentType    EmploymentType  @default(FULL_TIME)
  /// Last update time reported by the ATS (Greenhouse `updated_at`); null when the source has none.
  sourceUpdatedAt   DateTime?
  /// Department / team as published by the ATS (null when the source has none).
  department        String?
  /// Pay range stated by the employer in a structured ATS field (Greenhouse pay_input_ranges,
  /// Lever salaryRange, Ashby compensation…). Null when not published. Amounts are in `payCurrency`
  /// per `payPeriod` ("month" | "year" | "hour").
  payMin            Int?
  payMax            Int?
  payCurrency       String?
  payPeriod         String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  applications      Application[]
  contacts          Contact[]
  hiringProcesses   HiringProcess[]
  /// Exact LinkedIn posting (https://www.linkedin.com/jobs/view/<id>/) found via Brave Search; null = unknown.
  linkedinUrl       String?
  /// Last Brave lookup for linkedinUrl (found or not). Null = never checked.
  linkedinCheckedAt DateTime?
  /// Jobs map (src/lib/geo): primary point (approximate, city/tech-hub level) and every place key the
  /// location mentions (hub:* / gn:* / co:<companyId>). Null = not geocodable (e.g. "Israel" + foreign HQ).
  geoLat            Float?
  geoLng            Float?
  geoPlaces         String[]        @default([])
  /// office | hub | city | hq
  geoPrecision      String?
  /// What the geo was computed from (location + company HQ/office), so changes trigger a re-geocode.
  geoSource         String?
  geocodedAt        DateTime?

  @@unique([source, externalId])
  @@index([roleCategory, seniority])
  @@index([isActive, postedAt])
  @@index([isActive, jobFunction])
  @@index([isActive, domain])
  @@index([isActive, level])
  @@index([isActive, sourceUpdatedAt])
  @@index([companyId, isActive])
  @@index([isActive, geoLat])
  // Free-text search (ILIKE '%term%') — trigram GIN indexes, pg_trgm.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_description_trgm_idx")
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_location_trgm_idx")
  @@index([department(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_department_trgm_idx")
}

model Application {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId           String?
  job             Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  // For applications tracked manually (jobs found outside the platform)
  title           String
  company         String
  url             String?
  status          ApplicationStatus @default(SAVED)
  notes           String?
  appliedAt       DateTime?
  // How it got onto the board; EMAIL = detected by email sync (see emailMessageId)
  source          ApplicationSource @default(APP)
  emailMessageId  String?
  /// Hiring-process stage the user marked as current (a STAGE_KINDS key, see src/lib/hiring/kinds.ts).
  currentStage    String?
  currentStageAt  DateTime?
  /// When the status last changed (set by every status update; null for rows from before it existed).
  statusChangedAt DateTime?
  /// Next scheduled interview (reminders ~24h and ~2h before) and a free-text note (link, place, who).
  interviewAt     DateTime?
  interviewNote   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([interviewAt])
}

/// DEPRECATED: billing was removed (non-commercial practice project). Table kept, unused, because
/// migrations are additive-only. Do not build on it.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan      @default(FREE)
  status               String    @default("inactive")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  updatedAt            DateTime  @updatedAt
}

model IngestionRun {
  id          String      @id @default(cuid())
  provider    AtsProvider
  companyId   String?
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  created     Int         @default(0)
  updated     Int         @default(0)
  deactivated Int         @default(0)
  error       String?

  /// "Last scan" indicator on /jobs (src/lib/ingestion/last-scan-server.ts).
  @@index([finishedAt])
}

/// People search (docs/people-search.md): Brave web-search results for `site:linkedin.com/in` queries.
/// Only fields derived from the result's title/description/url are kept — we never fetch LinkedIn.
enum PeopleGroup {
  RECRUITER
  TEAM_LEAD
  ENGINEER
  MANAGER
  SENIOR_MGMT
  FOUNDER
}

enum PeopleSuppressionReason {
  HIDDEN
  REPORTED
}

/// Shared, short-lived cache of parsed search results (one row per company × group × query/page).
model PeopleSearchCache {
  id        String      @id @default(cuid())
  companyId String
  group     PeopleGroup
  queryHash String
  query     String
  page      Int         @default(0)
  results   Json
  hasMore   Boolean     @default(false)
  fetchedAt DateTime    @default(now())
  expiresAt DateTime

  @@unique([companyId, group, queryHash])
  @@index([expiresAt])
}

/// One row per uncached Brave lookup for a job's LinkedIn posting. Shares the Brave monthly budget with people search.
model LinkedinJobLookup {
  id        String   @id @default(cuid())
  jobId     String
  found     Boolean
  trigger   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One row per people-search request: drives the per-user rate limit, daily cap and monthly budget.
model PeopleSearchUsage {
  id        String      @id @default(cuid())
  userId    String
  companyId String
  group     PeopleGroup
  cached    Boolean
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([cached, createdAt])
}

/// "Hide" (per user) and "report / removal request" (hidden for everyone) for a profile URL.
model PeopleSearchSuppression {
  id         String                  @id @default(cuid())
  userId     String
  profileKey String
  reason     PeopleSuppressionReason
  createdAt  DateTime                @default(now())

  @@unique([userId, profileKey])
  @@index([profileKey, reason])
}

enum ContactCategory {
  TEAM_LEAD
  RECRUITER
  PEER
  SENIOR_MGMT
  FOUNDER
  HR
}

enum ContactStatus {
  NOT_CONTACTED
  SENT
  REPLIED
  REFERRED
}

/// A person the user found (manually, via a LinkedIn/Google search link) for a referral or intro.
/// We never scrape LinkedIn: every field here is typed by the user.
model Contact {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name        String
  title       String?
  linkedinUrl String?
  category    ContactCategory
  status      ContactStatus   @default(NOT_CONTACTED)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, jobId])
  @@index([userId, companyId])
}

// ---------------------------------------------------------------------------
// Email sync: detect applications / status updates from the user's mailbox.
// Privacy: we never store email bodies, only message id, sender, subject, date and extracted fields.
// ---------------------------------------------------------------------------

enum ApplicationSource {
  APP
  EMAIL
}

enum EmailProvider {
  GMAIL
  OUTLOOK
}

enum EmailScanFrequency {
  MANUAL
  DAILY
  EVERY_6H
}

enum EmailConfidence {
  STRICT
  BALANCED
  AGGRESSIVE
}

enum EmailCandidateKind {
  APPLICATION
  STATUS_UPDATE
}

enum EmailCandidateStatus {
  PENDING // waiting for the user in the review queue
  AUTO_ADDED // created/updated an application automatically
  APPROVED // approved from the review queue
  DISMISSED
  DUPLICATE // already on the board
}

model EmailSyncSettings {
  id                  String             @id @default(cuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lookbackDays        Int                @default(7)
  frequency           EmailScanFrequency @default(MANUAL)
  confidence          EmailConfidence    @default(BALANCED)
  detectStatusUpdates Boolean            @default(true)
  lastScanAt          DateTime?
  lastScanSummary     Json?
  lastScanError       String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model EmailAccount {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        EmailProvider
  emailAddress    String
  /// AES-256-GCM ciphertext (key: EMAIL_TOKEN_ENC_KEY). Never store or log the plain token.
  refreshTokenEnc String
  scope           String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, provider])
}

model EmailCandidate {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       EmailProvider
  messageId      String
  threadId       String?
  fromAddress    String
  subject        String
  receivedAt     DateTime
  kind           EmailCandidateKind
  detectedStatus ApplicationStatus?
  company        String?
  title          String?
  /// Best-matching Job / Application ids (plain ids, validated on use)
  matchedJobId   String?
  applicationId  String?
  confidence     Int
  reasons        String[]
  status         EmailCandidateStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([userId, provider, messageId])
  @@index([userId, status])
}

/// Cached AI responses keyed by a hash of model + prompt, so identical requests never hit the provider twice.
model AiCache {
  id        String   @id @default(cuid())
  feature   String
  key       String
  model     String
  value     String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([feature, key])
  @@index([expiresAt])
}

/// One row per AI request (including cache hits and refusals) for per-user / global free-tier limits.
model AiUsage {
  id        String   @id @default(cuid())
  userId    String?
  feature   String
  model     String
  outcome   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt, outcome])
}

/// Learning roadmaps (src/lib/learning): no row = not started.
enum LearningStatus {
  LEARNING
  DONE
}

/// Per-user progress on a skill-graph node. `skill` is the node id (e.g. "kubernetes").
model SkillProgress {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill          String
  status         LearningStatus
  proofUrl       String?
  /// True when marking DONE added the skill to the profile (so undo removes only what we added).
  addedToProfile Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, skill])
  @@index([skill])
}

/// Jobs map: a user's saved commute origins ("Home", "University"). Exact coordinates stay here only;
/// commute lookups and caches use a ~200 m rounded point (src/lib/commute/keys.ts).
model SavedPlace {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  lat       Float
  lng       Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Travel-time cache: (rounded origin, destination point, mode, departure bucket) -> seconds.
/// `seconds` null = no route found (cached too, so we do not ask again).
/// mode: "car" | "transit" (matrix rows) or "transit-route" (one itinerary with legs in `route`).
/// Legacy "bus" / "train" rows (pre combined transit) are no longer read and simply expire.
model CommuteCache {
  id         String   @id @default(cuid())
  originKey  String
  destKey    String
  mode       String
  timeBucket String
  seconds    Int?
  transfers  Int?
  /// "transit-route" rows: TransitRoute JSON (legs, transfers, walking, times); null = no itinerary.
  route      Json?
  provider   String
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime

  @@unique([originKey, destKey, mode, timeBucket])
  @@index([expiresAt])
}

/// One row per outbound routing/geocoding request, for daily caps and provider etiquette.
model GeoProviderCall {
  id        String   @id @default(cuid())
  provider  String
  kind      String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([provider, createdAt])
}

/// Address geocoding cache (Nominatim results for saved places / office overrides).
model GeocodeCache {
  id        String   @id @default(cuid())
  query     String   @unique
  lat       Float?
  lng       Float?
  label     String?
  provider  String
  createdAt DateTime @default(now())
}

/// Kinds of documents a user can keep for applications. CVs uploaded through the profile flow stay in
/// `Resume` (they are parsed); `CV` here exists so the apply flow can treat both sources uniformly.
enum DocumentType {
  CV
  TRANSCRIPT
  DEGREE
  CERTIFICATION
  RECOMMENDATION_LETTER
  PORTFOLIO
  COVER_LETTER
  OTHER
}

/// A user's application document (grades, degree, certification, ...). File bytes live in private
/// object storage (Vercel Blob, private store) under `storageKey`; only metadata is in Postgres.
/// Access goes through /api/documents/[id]/file (session + ownership + short-lived signed token).
model Document {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       DocumentType
  title      String
  issuer     String?
  issueDate  DateTime?
  expiryDate DateTime?
  /// "he" | "en" | null
  language   String?
  tags       String[]     @default([])
  notes      String?
  /// Learning-graph node ids this document proves (certifications); added to the profile on save.
  skills     String[]     @default([])
  fileName   String
  /// Sniffed from magic bytes on upload, never trusted from the client.
  mimeType   String
  sizeBytes  Int
  sha256     String
  storageKey String       @unique
  version    Int          @default(1)
  /// When the current file version was uploaded (used for the upload rate limit).
  uploadedAt DateTime     @default(now())
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId, type])
}

// ── Learning hub: per-stage progress, study log, spaced review, shared stage content, AI tutor ──

/// Progress on one stage (fundamentals / intermediate / applied) of a skill.
model StageProgress {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill      String
  stage      String
  status     LearningStatus @default(LEARNING)
  /// Roadmap topics (node.stages[stage]) the user ticked.
  topicsDone String[]       @default([])
  /// { [exerciseId]: { done: boolean, notes?: string } } — validated in src/lib/learning/progress.ts.
  practice   Json           @default("{}")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, skill, stage])
  @@index([userId, updatedAt])
}

/// Optional study-time log entry.
model StudySession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     String
  stage     String?
  minutes   Int
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model LearningPrefs {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyGoalHours Int      @default(5)
  updatedAt       DateTime @updatedAt
}

enum ReviewRating {
  KNEW
  PARTLY
  MISSED
}

/// Spaced-repetition-lite state for one Q&A card. Question/answer are snapshotted so reviews
/// survive content regeneration.
model QuestionReview {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill      String
  stage      String
  questionId String
  question   String
  answer     String
  rating     ReviewRating
  reps       Int          @default(0)
  dueAt      DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([userId, skill, stage, questionId])
  @@index([userId, dueAt])
}

/// Practice + Q&A for one (skill, stage, locale), shared by all users. Generated once by the
/// LLM (or absent → curated/static fallback is used without persisting).
model StageContent {
  id         String   @id @default(cuid())
  skill      String
  stage      String
  locale     String
  source     String
  model      String?
  content    Json
  regenCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([skill, stage, locale])
}

model TutorThread {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     String
  stage     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  TutorMessage[]

  @@index([userId, skill, stage, updatedAt])
}

model TutorMessage {
  id        String      @id @default(cuid())
  threadId  String
  thread    TutorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime    @default(now())

  @@index([threadId, createdAt])
}

/// Hiring process (docs/hiring-process.md). kind "official" = extracted from cited company-owned public pages
/// (careers pages, official blogs, the job description); every stage carries a verbatim `evidence` quote from
/// its `sourceUrl`. kind "user" = one signed-in user's own experience (shown only to that user).
/// `jobId` set = specific to one job; null = company-wide.
model HiringProcess {
  id                String        @id @default(cuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId             String?
  job               Job?          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// "official" | "user"
  kind              String        @default("official")
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "found" = at least one grounded stage; "none" = sources were checked and no process is published.
  status            String        @default("none")
  /// "high" | "medium" | "low"
  confidence        String        @default("low")
  /// Overall duration as stated by the source (e.g. "2-4 weeks"); null when not stated.
  estimatedDuration String?
  notesHe           String?
  notesEn           String?
  /// [{ url, title }] pages that support at least one stage.
  sources           Json          @default("[]")
  /// [{ url, title, result: "stages" | "no_info" | "blocked" | "bot_wall" | "js_rendered" | "error" }] every page that was looked at.
  checked           Json          @default("[]")
  /// "gemini-…" | "heuristic" | "user"
  method            String?
  /// Why status is "none": no_website | robots | bot_wall | js_rendered | unreachable | no_process_text |
  /// no_pages | llm_none | grounding_dropped | below_threshold (docs/hiring-process.md).
  failureReason     String?
  /// Pipeline version that produced the row; older versions are re-checked by the cron.
  pipelineVersion   Int           @default(1)
  /// Discovery/extraction counters (fetches, bot walls, sitemap URLs, job sources, proposed stages).
  diagnostics       Json?
  checkedAt         DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  stages            HiringStage[]

  @@index([companyId, kind])
  @@index([jobId])
  @@index([userId, companyId])
}

/// One ordered stage of a HiringProcess.
model HiringStage {
  id        String        @id @default(cuid())
  processId String
  process   HiringProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  order     Int
  /// STAGE_KINDS key: phone_screen, home_assignment, technical, system_design, hr, manager, offer…
  kind      String
  /// Stage name as the source (or the user) calls it.
  title     String
  detailHe  String?
  detailEn  String?
  /// Stage duration as stated by the source (e.g. "45 minutes").
  duration  String?
  /// Verbatim quote from `sourceUrl` that supports this stage (official processes only).
  evidence  String?
  sourceUrl String?

  @@index([processId, order])
}

/// Assistant chat (docs/chatbot.md): one conversation per thread, owned by a user.
model ChatThread {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// First user message, trimmed (shown in the history list).
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// "user" | "assistant"
  role      String
  /// Plain text (what the model sees as history).
  content   String
  /// UI message parts (text + tool results) so history re-renders the cards; null for user messages.
  parts     Json?
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

/// AI (or offline) feedback on the user's own answer to a practice exercise or a Q&A question.
/// One row per user × skill × stage × item; re-checking overwrites it. See docs/learning.md.
model AnswerFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     String
  stage     String
  /// "exercise" | "question"
  kind      String
  itemId    String
  answer    String
  /// Validated with answerFeedbackSchema (src/lib/learning/feedback.ts).
  result    Json
  /// "ai" | "offline" | "limited"
  source    String
  model     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, skill, stage, itemId])
  @@index([userId, updatedAt])
}

// ── Notifications (issue #41) ─────────────────────────────────────────────────────────────────────
// Kinds and channels are plain strings (validated in src/lib/notifications/kinds.ts) so new ones
// never need an enum migration.

/// One in-site notification. Push / Telegram copies are tracked in NotificationDelivery.
model Notification {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// JOB_MATCH | SAVED_JOB_CLOSED | FOLLOW_UP | SYSTEM (see kinds.ts)
  kind       String
  title      String
  body       String?
  /// In-app path (e.g. /jobs/abc) the notification opens.
  url        String?
  data       Json?
  /// Same key twice for the same user = same event; the second insert is skipped.
  dedupeKey  String?
  readAt     DateTime?
  createdAt  DateTime               @default(now())
  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Quiet hours, Israel time; start > end wraps midnight (22 → 7).
  quietEnabled        Boolean   @default(true)
  quietStart          Int       @default(22)
  quietEnd            Int       @default(7)
  /// Also quiet from Friday quietStartShabbat (16:00) to Saturday night (20:00).
  quietShabbat        Boolean   @default(false)
  followUpEnabled     Boolean   @default(true)
  followUpDays        Int       @default(7)
  /// Per-kind overrides: { "JOB_MATCH": { "push": false, "telegram": true }, ... }. Missing = default on.
  channels            Json      @default("{}")
  /// Max push/Telegram messages per hour; the rest stay in-app only.
  maxPerHour          Int       @default(6)
  /// One-time code for linking Telegram (/start <code>), hashed, short-lived.
  telegramLinkCode    String?   @unique
  telegramLinkExpires DateTime?
  /// Learning reminders: on these Israel weekdays (0 = Sunday) at/after this hour.
  learningEnabled     Boolean   @default(true)
  learningHour        Int       @default(19)
  learningDays        Int[]     @default([0, 1, 2, 3, 4])
  /// Nudge after this many days without study (streak / due reviews nudge regardless).
  learningIdleDays    Int       @default(2)
  interviewEnabled    Boolean   @default(true)
  /// Daily digest, generated once per Israel day at/after digestHour.
  digestEnabled       Boolean   @default(true)
  digestHour          Int       @default(8)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// One daily digest per user per Israel day (YYYY-MM-DD), kept as history (see docs/digest.md).
model Digest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day         String
  /// Short one-line summary (also the notification body).
  summary     String
  /// Structured sections (src/lib/digest/build.ts DigestContent).
  content     Json
  /// "Streamline your process" suggestions and where they came from: ai | offline | limited.
  suggestions Json     @default("[]")
  aiSource    String   @default("offline")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId, createdAt])
}

/// A /jobs query the user wants alerts for. `query` is the /jobs query string (without "?").
model SavedSearch {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  query          String
  active         Boolean   @default(true)
  /// Jobs created after this were not checked yet.
  lastCheckedAt  DateTime  @default(now())
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([active])
}

/// An external delivery target: a browser push subscription or a linked Telegram chat.
model NotificationChannel {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// WEB_PUSH | TELEGRAM
  type       String
  /// Push endpoint URL, or Telegram chat id.
  endpoint   String
  p256dh     String?
  auth       String?
  label      String?
  failures   Int                    @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime               @default(now())
  deliveries NotificationDelivery[]

  @@unique([type, endpoint])
  @@index([userId])
}

/// Send queue with retry: one row per notification × channel.
model NotificationDelivery {
  id             String              @id @default(cuid())
  notificationId String
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channelId      String
  channel        NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// PENDING | SENT | FAILED | SKIPPED
  status         String              @default("PENDING")
  attempts       Int                 @default(0)
  /// Not before this (quiet hours / backoff).
  nextAttemptAt  DateTime            @default(now())
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  @@unique([notificationId, channelId])
  @@index([status, nextAttemptAt])
}
