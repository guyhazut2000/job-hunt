generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
}

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum SkillLevel {
  BASIC
  GOOD
  EXPERT
}

enum Availability {
  ACTIVE
  OPEN
  NOT_LOOKING
}

enum AtsProvider {
  GREENHOUSE
  LEVER
  COMEET
  MANUAL
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  passwordHash String
  role         Role          @default(USER)
  plan         Plan          @default(FREE)
  locale       String        @default("he")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  resumes      Resume[]
  applications Application[]
  subscription Subscription?
  contacts     Contact[]
}

model Profile {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String?
  desiredRole     String?
  seniority       Seniority?
  location        String?
  workMode        WorkMode?
  yearsExperience Int?
  skills          String[]
  linkedinUrl     String?
  updatedAt       DateTime   @updatedAt

  // ── v2 professional profile (validated by zod in src/lib/profile/schema.ts) ──
  summary           String?
  githubUrl         String?
  portfolioUrl      String?
  experience        Json          @default("[]")
  skillItems        Json          @default("[]")
  education         Json          @default("[]")
  languages         Json          @default("[]")
  // ── v2 preferences ──
  targetRoles       String[]      @default([])
  targetSeniorities Seniority[]   @default([])
  regions           String[]      @default([])
  workModes         WorkMode[]    @default([])
  salaryMin         Int?
  salaryMax         Int?
  companyTypes      String[]      @default([])
  wantedTech        String[]      @default([])
  avoidTech         String[]      @default([])
  availability      Availability?
  onboardedAt       DateTime?
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  text      String
  skills    String[]
  isPrimary Boolean  @default(true)
  createdAt DateTime @default(now())
  label     String?
  extracted Json?
  appliedAt DateTime?
  file      ResumeFile?

  @@index([userId])
}

/// Original uploaded CV bytes. Kept in a separate table so listing resumes never loads blobs.
/// No Vercel Blob store is configured for this project, so files live in Postgres (bytea, max 5MB).
model ResumeFile {
  id        String   @id @default(cuid())
  resumeId  String   @unique
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  data      Bytes
  createdAt DateTime @default(now())
}

model Company {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  website      String?
  description  String?
  industry     String?
  size         String?
  hqLocation   String?
  logoUrl      String?
  atsProvider  AtsProvider @default(MANUAL)
  atsBoardId   String?
  lastSyncedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  jobs         Job[]
  contacts     Contact[]
}

model Job {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId   String
  source       AtsProvider
  title        String
  roleCategory String
  seniority    Seniority
  location     String
  workMode     WorkMode
  techStack    String[]
  description  String
  applyUrl     String
  postedAt     DateTime
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  contacts     Contact[]

  @@unique([source, externalId])
  @@index([roleCategory, seniority])
  @@index([isActive, postedAt])
}

model Application {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  // For applications tracked manually (jobs found outside the platform)
  title     String
  company   String
  url       String?
  status    ApplicationStatus @default(SAVED)
  notes     String?
  appliedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, jobId])
  @@index([userId, status])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan      @default(FREE)
  status               String    @default("inactive")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  updatedAt            DateTime  @updatedAt
}

model IngestionRun {
  id          String      @id @default(cuid())
  provider    AtsProvider
  companyId   String?
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  created     Int         @default(0)
  updated     Int         @default(0)
  deactivated Int         @default(0)
  error       String?
}

enum ContactCategory {
  TEAM_LEAD
  RECRUITER
  PEER
  SENIOR_MGMT
  FOUNDER
  HR
}

enum ContactStatus {
  NOT_CONTACTED
  SENT
  REPLIED
  REFERRED
}

/// A person the user found (manually, via a LinkedIn/Google search link) for a referral or intro.
/// We never scrape LinkedIn: every field here is typed by the user.
model Contact {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name        String
  title       String?
  linkedinUrl String?
  category    ContactCategory
  status      ContactStatus   @default(NOT_CONTACTED)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, jobId])
  @@index([userId, companyId])
}
