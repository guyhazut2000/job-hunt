generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

/// DEPRECATED: pricing was removed (non-commercial practice project). Kept only because migrations
/// are additive-only; nothing reads or writes it.
enum Plan {
  FREE
  PRO
}

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
}

/// Job-board style experience level, derived from the title. Finer than `Seniority`
/// (which the profile matcher uses): it separates directors and executives from line managers.
enum JobLevel {
  INTERN
  ENTRY
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum SkillLevel {
  BASIC
  GOOD
  EXPERT
}

enum Availability {
  ACTIVE
  OPEN
  NOT_LOOKING
}

enum AtsProvider {
  GREENHOUSE
  LEVER
  COMEET
  MANUAL
  ASHBY
  WORKABLE
  SMARTRECRUITERS
  WORKDAY
  RECRUITEE
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  name            String?
  passwordHash    String
  role            Role               @default(USER)
  /// DEPRECATED: unused since pricing was removed; kept for additive-only migrations.
  plan            Plan               @default(FREE)
  locale          String             @default("he")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  profile         Profile?
  resumes         Resume[]
  applications    Application[]
  /// DEPRECATED: unused since pricing was removed.
  subscription    Subscription?
  contacts        Contact[]
  emailSync       EmailSyncSettings?
  emailAccounts   EmailAccount[]
  emailCandidates EmailCandidate[]
  skillProgress   SkillProgress[]
  savedPlaces     SavedPlace[]
  documents       Document[]
  stageProgress   StageProgress[]
  studySessions   StudySession[]
  questionReviews QuestionReview[]
  tutorThreads    TutorThread[]
  learningPrefs   LearningPrefs?
}

model Profile {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String?
  desiredRole     String?
  seniority       Seniority?
  location        String?
  workMode        WorkMode?
  yearsExperience Int?
  skills          String[]
  linkedinUrl     String?
  updatedAt       DateTime   @updatedAt

  // ── v2 professional profile (validated by zod in src/lib/profile/schema.ts) ──
  summary           String?
  githubUrl         String?
  portfolioUrl      String?
  experience        Json          @default("[]")
  skillItems        Json          @default("[]")
  education         Json          @default("[]")
  languages         Json          @default("[]")
  // ── v2 preferences ──
  targetRoles       String[]      @default([])
  targetSeniorities Seniority[]   @default([])
  regions           String[]      @default([])
  workModes         WorkMode[]    @default([])
  salaryMin         Int?
  salaryMax         Int?
  companyTypes      String[]      @default([])
  wantedTech        String[]      @default([])
  avoidTech         String[]      @default([])
  availability      Availability?
  onboardedAt       DateTime?
}

model Resume {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  text      String
  skills    String[]
  isPrimary Boolean     @default(true)
  createdAt DateTime    @default(now())
  label     String?
  extracted Json?
  appliedAt DateTime?
  file      ResumeFile?

  @@index([userId])
}

/// Original uploaded CV bytes. Kept in a separate table so listing resumes never loads blobs.
/// No Vercel Blob store is configured for this project, so files live in Postgres (bytea, max 5MB).
model ResumeFile {
  id        String   @id @default(cuid())
  resumeId  String   @unique
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  data      Bytes
  createdAt DateTime @default(now())
}

model Company {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  website      String?
  description  String?
  industry     String?
  size         String?
  hqLocation   String?
  logoUrl      String?
  /// Normalized https://www.linkedin.com/company/<slug>/ set by an admin; never fetched (see docs/linkedin-links.md).
  linkedinUrl  String?
  atsProvider  AtsProvider    @default(MANUAL)
  atsBoardId   String?
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  jobs         Job[]
  contacts     Contact[]
  salaries     SalaryReport[]

  /// AUTO = jobs are pulled from `atsProvider`/`atsBoardId`; MANUAL = no working feed, the user checks
  /// `careersUrl` by hand. Companies are never hidden or deleted because a feed is missing or failing.
  syncMode          CompanySyncMode    @default(AUTO)
  /// The company's own careers page (never a LinkedIn URL).
  careersUrl        String?
  notesHe           String?
  notesEn           String?
  /// Last ingest error for an AUTO company (cleared on the next successful sync).
  lastSyncError     String?
  lastSyncErrorAt   DateTime?
  /// Consecutive failed syncs; >= SYNC_FAILING_THRESHOLD shows a "feed failing" note in the UI.
  syncFailures      Int                @default(0)
  /// How the company got here: "curated", "manual-seed", "admin", "discovery:YC", "discovery:WIKIDATA"…
  addedVia          String?
  startupCandidates StartupCandidate[]

  /// Optional office override for the jobs map (docs/jobs-map.md), set by an admin. When `officeCity`
  /// is set it replaces only that city's pin; null applies to all of the company's jobs.
  officeAddress String?
  officeLat     Float?
  officeLng     Float?
  officeCity    String?

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_name_trgm_idx")
}

enum CompanySyncMode {
  AUTO
  MANUAL
}

enum StartupCandidateStatus {
  /// Waiting for an admin (no supported ATS with Israeli openings was detected).
  PENDING
  /// Became a Company (AUTO if an ATS feed was detected, otherwise MANUAL).
  ADDED
  REJECTED
  /// Already in the app under another name/source.
  DUPLICATE
}

/// Startup discovery (docs/startup-discovery.md): companies found in public directories, waiting to be
/// checked for a careers page / ATS and added. One row per website domain.
model StartupCandidate {
  id               String                 @id @default(cuid())
  domain           String                 @unique
  name             String
  website          String
  source           String
  sourceUrl        String?
  description      String?
  location         String?
  industry         String?
  /// TechMap size bucket (xs 1-10, s 11-50, m 51-200, l 201-1,000, xl 1,001+) when known.
  size             String?
  foundedYear      Int?
  /// Higher = checked first (bigger companies, known ATS hints, hiring signals).
  priority         Int                    @default(0)
  /// ATS identifiers the source already knows (e.g. TechMap greenhouseId / leverId / comeetId).
  hints            Json?
  status           StartupCandidateStatus @default(PENDING)
  /// Result of the last ATS check of the company's own site.
  careersUrl       String?
  detectedProvider AtsProvider?
  detectedBoardId  String?
  israelJobs       Int?
  checkedAt        DateTime?
  checkError       String?
  companyId        String?
  company          Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([status, checkedAt])
  @@index([checkedAt, priority])
}

/// One discovery cron/admin run: import from the public directories and/or check a batch of candidates.
model DiscoveryRun {
  id         String    @id @default(cuid())
  trigger    String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// New candidates per source, e.g. {"TECHMAP": 812, "YC": 20}.
  imported   Json?
  checked    Int       @default(0)
  addedAuto  Int       @default(0)
  pending    Int       @default(0)
  error      String?
}

/// Anonymous salary report. No user id, no free text: `reporterKey` is an HMAC of the user id
/// (keyed with AUTH_SECRET) used only for de-duplication and rate limiting. Only aggregates over
/// >= 5 reports are ever shown (see src/lib/salary).
model SalaryReport {
  id              String    @id @default(cuid())
  reporterKey     String
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  family          String
  seniority       Seniority
  yearsExperience Int?
  monthlyGrossIls Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([reporterKey, companyId, family])
  @@index([companyId, family, seniority])
  @@index([family, seniority])
  @@index([reporterKey, updatedAt])
}

model Job {
  id                String         @id @default(cuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId        String
  source            AtsProvider
  title             String
  roleCategory      String
  seniority         Seniority
  location          String
  workMode          WorkMode
  techStack         String[]
  description       String
  applyUrl          String
  postedAt          DateTime
  /// Broad job function (engineering, data, sales, marketing…) — see src/lib/jobs/classify.ts.
  jobFunction       String         @default("other")
  level             JobLevel       @default(MID)
  employmentType    EmploymentType @default(FULL_TIME)
  /// Last update time reported by the ATS (Greenhouse `updated_at`); null when the source has none.
  sourceUpdatedAt   DateTime?
  /// Department / team as published by the ATS (null when the source has none).
  department        String?
  /// Pay range stated by the employer in a structured ATS field (Greenhouse pay_input_ranges,
  /// Lever salaryRange, Ashby compensation…). Null when not published. Amounts are in `payCurrency`
  /// per `payPeriod` ("month" | "year" | "hour").
  payMin            Int?
  payMax            Int?
  payCurrency       String?
  payPeriod         String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  applications      Application[]
  contacts          Contact[]
  /// Exact LinkedIn posting (https://www.linkedin.com/jobs/view/<id>/) found via Brave Search; null = unknown.
  linkedinUrl       String?
  /// Last Brave lookup for linkedinUrl (found or not). Null = never checked.
  linkedinCheckedAt DateTime?
  /// Jobs map (src/lib/geo): primary point (approximate, city/tech-hub level) and every place key the
  /// location mentions (hub:* / gn:* / co:<companyId>). Null = not geocodable (e.g. "Israel" + foreign HQ).
  geoLat            Float?
  geoLng            Float?
  geoPlaces         String[]       @default([])
  /// office | hub | city | hq
  geoPrecision      String?
  /// What the geo was computed from (location + company HQ/office), so changes trigger a re-geocode.
  geoSource         String?
  geocodedAt        DateTime?

  @@unique([source, externalId])
  @@index([roleCategory, seniority])
  @@index([isActive, postedAt])
  @@index([isActive, jobFunction])
  @@index([isActive, level])
  @@index([isActive, sourceUpdatedAt])
  @@index([companyId, isActive])
  @@index([isActive, geoLat])
  // Free-text search (ILIKE '%term%') — trigram GIN indexes, pg_trgm.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_description_trgm_idx")
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_location_trgm_idx")
  @@index([department(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_department_trgm_idx")
}

model Application {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId          String?
  job            Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  // For applications tracked manually (jobs found outside the platform)
  title          String
  company        String
  url            String?
  status         ApplicationStatus @default(SAVED)
  notes          String?
  appliedAt      DateTime?
  // How it got onto the board; EMAIL = detected by email sync (see emailMessageId)
  source         ApplicationSource @default(APP)
  emailMessageId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([userId, jobId])
  @@index([userId, status])
}

/// DEPRECATED: billing was removed (non-commercial practice project). Table kept, unused, because
/// migrations are additive-only. Do not build on it.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan      @default(FREE)
  status               String    @default("inactive")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  updatedAt            DateTime  @updatedAt
}

model IngestionRun {
  id          String      @id @default(cuid())
  provider    AtsProvider
  companyId   String?
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  created     Int         @default(0)
  updated     Int         @default(0)
  deactivated Int         @default(0)
  error       String?
}

/// People search (docs/people-search.md): Brave web-search results for `site:linkedin.com/in` queries.
/// Only fields derived from the result's title/description/url are kept — we never fetch LinkedIn.
enum PeopleGroup {
  RECRUITER
  TEAM_LEAD
  ENGINEER
  MANAGER
  SENIOR_MGMT
  FOUNDER
}

enum PeopleSuppressionReason {
  HIDDEN
  REPORTED
}

/// Shared, short-lived cache of parsed search results (one row per company × group × query/page).
model PeopleSearchCache {
  id        String      @id @default(cuid())
  companyId String
  group     PeopleGroup
  queryHash String
  query     String
  page      Int         @default(0)
  results   Json
  hasMore   Boolean     @default(false)
  fetchedAt DateTime    @default(now())
  expiresAt DateTime

  @@unique([companyId, group, queryHash])
  @@index([expiresAt])
}

/// One row per uncached Brave lookup for a job's LinkedIn posting. Shares the Brave monthly budget with people search.
model LinkedinJobLookup {
  id        String   @id @default(cuid())
  jobId     String
  found     Boolean
  trigger   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One row per people-search request: drives the per-user rate limit, daily cap and monthly budget.
model PeopleSearchUsage {
  id        String      @id @default(cuid())
  userId    String
  companyId String
  group     PeopleGroup
  cached    Boolean
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([cached, createdAt])
}

/// "Hide" (per user) and "report / removal request" (hidden for everyone) for a profile URL.
model PeopleSearchSuppression {
  id         String                  @id @default(cuid())
  userId     String
  profileKey String
  reason     PeopleSuppressionReason
  createdAt  DateTime                @default(now())

  @@unique([userId, profileKey])
  @@index([profileKey, reason])
}

enum ContactCategory {
  TEAM_LEAD
  RECRUITER
  PEER
  SENIOR_MGMT
  FOUNDER
  HR
}

enum ContactStatus {
  NOT_CONTACTED
  SENT
  REPLIED
  REFERRED
}

/// A person the user found (manually, via a LinkedIn/Google search link) for a referral or intro.
/// We never scrape LinkedIn: every field here is typed by the user.
model Contact {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name        String
  title       String?
  linkedinUrl String?
  category    ContactCategory
  status      ContactStatus   @default(NOT_CONTACTED)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, jobId])
  @@index([userId, companyId])
}

// ---------------------------------------------------------------------------
// Email sync: detect applications / status updates from the user's mailbox.
// Privacy: we never store email bodies, only message id, sender, subject, date and extracted fields.
// ---------------------------------------------------------------------------

enum ApplicationSource {
  APP
  EMAIL
}

enum EmailProvider {
  GMAIL
  OUTLOOK
}

enum EmailScanFrequency {
  MANUAL
  DAILY
  EVERY_6H
}

enum EmailConfidence {
  STRICT
  BALANCED
  AGGRESSIVE
}

enum EmailCandidateKind {
  APPLICATION
  STATUS_UPDATE
}

enum EmailCandidateStatus {
  PENDING // waiting for the user in the review queue
  AUTO_ADDED // created/updated an application automatically
  APPROVED // approved from the review queue
  DISMISSED
  DUPLICATE // already on the board
}

model EmailSyncSettings {
  id                  String             @id @default(cuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lookbackDays        Int                @default(7)
  frequency           EmailScanFrequency @default(MANUAL)
  confidence          EmailConfidence    @default(BALANCED)
  detectStatusUpdates Boolean            @default(true)
  lastScanAt          DateTime?
  lastScanSummary     Json?
  lastScanError       String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model EmailAccount {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        EmailProvider
  emailAddress    String
  /// AES-256-GCM ciphertext (key: EMAIL_TOKEN_ENC_KEY). Never store or log the plain token.
  refreshTokenEnc String
  scope           String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, provider])
}

model EmailCandidate {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       EmailProvider
  messageId      String
  threadId       String?
  fromAddress    String
  subject        String
  receivedAt     DateTime
  kind           EmailCandidateKind
  detectedStatus ApplicationStatus?
  company        String?
  title          String?
  /// Best-matching Job / Application ids (plain ids, validated on use)
  matchedJobId   String?
  applicationId  String?
  confidence     Int
  reasons        String[]
  status         EmailCandidateStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([userId, provider, messageId])
  @@index([userId, status])
}

/// Cached AI responses keyed by a hash of model + prompt, so identical requests never hit the provider twice.
model AiCache {
  id        String   @id @default(cuid())
  feature   String
  key       String
  model     String
  value     String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([feature, key])
  @@index([expiresAt])
}

/// One row per AI request (including cache hits and refusals) for per-user / global free-tier limits.
model AiUsage {
  id        String   @id @default(cuid())
  userId    String?
  feature   String
  model     String
  outcome   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt, outcome])
}

/// Learning roadmaps (src/lib/learning): no row = not started.
enum LearningStatus {
  LEARNING
  DONE
}

/// Per-user progress on a skill-graph node. `skill` is the node id (e.g. "kubernetes").
model SkillProgress {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill          String
  status         LearningStatus
  proofUrl       String?
  /// True when marking DONE added the skill to the profile (so undo removes only what we added).
  addedToProfile Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, skill])
  @@index([skill])
}

/// Jobs map: a user's saved commute origins ("Home", "University"). Exact coordinates stay here only;
/// commute lookups and caches use a ~200 m rounded point (src/lib/commute/keys.ts).
model SavedPlace {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  lat       Float
  lng       Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Travel-time cache: (rounded origin, destination point, mode, departure bucket) -> seconds.
/// `seconds` null = no route found (cached too, so we do not ask again).
model CommuteCache {
  id         String   @id @default(cuid())
  originKey  String
  destKey    String
  mode       String
  timeBucket String
  seconds    Int?
  transfers  Int?
  provider   String
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime

  @@unique([originKey, destKey, mode, timeBucket])
  @@index([expiresAt])
}

/// One row per outbound routing/geocoding request, for daily caps and provider etiquette.
model GeoProviderCall {
  id        String   @id @default(cuid())
  provider  String
  kind      String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([provider, createdAt])
}

/// Address geocoding cache (Nominatim results for saved places / office overrides).
model GeocodeCache {
  id        String   @id @default(cuid())
  query     String   @unique
  lat       Float?
  lng       Float?
  label     String?
  provider  String
  createdAt DateTime @default(now())
}

/// Kinds of documents a user can keep for applications. CVs uploaded through the profile flow stay in
/// `Resume` (they are parsed); `CV` here exists so the apply flow can treat both sources uniformly.
enum DocumentType {
  CV
  TRANSCRIPT
  DEGREE
  CERTIFICATION
  RECOMMENDATION_LETTER
  PORTFOLIO
  COVER_LETTER
  OTHER
}

/// A user's application document (grades, degree, certification, ...). File bytes live in private
/// object storage (Vercel Blob, private store) under `storageKey`; only metadata is in Postgres.
/// Access goes through /api/documents/[id]/file (session + ownership + short-lived signed token).
model Document {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       DocumentType
  title      String
  issuer     String?
  issueDate  DateTime?
  expiryDate DateTime?
  /// "he" | "en" | null
  language   String?
  tags       String[]     @default([])
  notes      String?
  /// Learning-graph node ids this document proves (certifications); added to the profile on save.
  skills     String[]     @default([])
  fileName   String
  /// Sniffed from magic bytes on upload, never trusted from the client.
  mimeType   String
  sizeBytes  Int
  sha256     String
  storageKey String       @unique
  version    Int          @default(1)
  /// When the current file version was uploaded (used for the upload rate limit).
  uploadedAt DateTime     @default(now())
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId, type])
}

// ── Learning hub: per-stage progress, study log, spaced review, shared stage content, AI tutor ──

/// Progress on one stage (fundamentals / intermediate / applied) of a skill.
model StageProgress {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill      String
  stage      String
  status     LearningStatus @default(LEARNING)
  /// Roadmap topics (node.stages[stage]) the user ticked.
  topicsDone String[]       @default([])
  /// { [exerciseId]: { done: boolean, notes?: string } } — validated in src/lib/learning/progress.ts.
  practice   Json           @default("{}")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, skill, stage])
  @@index([userId, updatedAt])
}

/// Optional study-time log entry.
model StudySession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     String
  stage     String?
  minutes   Int
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model LearningPrefs {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyGoalHours Int      @default(5)
  updatedAt       DateTime @updatedAt
}

enum ReviewRating {
  KNEW
  PARTLY
  MISSED
}

/// Spaced-repetition-lite state for one Q&A card. Question/answer are snapshotted so reviews
/// survive content regeneration.
model QuestionReview {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill      String
  stage      String
  questionId String
  question   String
  answer     String
  rating     ReviewRating
  reps       Int          @default(0)
  dueAt      DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([userId, skill, stage, questionId])
  @@index([userId, dueAt])
}

/// Practice + Q&A for one (skill, stage, locale), shared by all users. Generated once by the
/// LLM (or absent → curated/static fallback is used without persisting).
model StageContent {
  id         String   @id @default(cuid())
  skill      String
  stage      String
  locale     String
  source     String
  model      String?
  content    Json
  regenCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([skill, stage, locale])
}

model TutorThread {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     String
  stage     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  TutorMessage[]

  @@index([userId, skill, stage, updatedAt])
}

model TutorMessage {
  id        String      @id @default(cuid())
  threadId  String
  thread    TutorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime    @default(now())

  @@index([threadId, createdAt])
}
